# ──────────────────────────────────────────────
#  VisionGuard AI — Environment Variables
#  Copy this file to .env and fill in values
# ──────────────────────────────────────────────

# Server port (default: 5000)
PORT=5000

# Frontend URL for CORS (use * for development)
FRONTEND_URL=http://localhost:5000

# ── MongoDB ────────────────────────────────────
# MongoDB connection string (Atlas or local)
# Example: mongodb://localhost:27017/visionguard
# Example: mongodb+srv://user:pass@cluster.mongodb.net/visionguard
MONGODB_URI=mongodb://localhost:27017/visionguard

# ── JWT ────────────────────────────────────────
# Secret key for signing JWT tokens — use a long random string
JWT_SECRET=replace-with-a-long-random-secret-string

# ── Sightengine AI API ─────────────────────────
# Sign up free at https://sightengine.com
# Dashboard > API Keys > api_user and api_secret
SIGHTENGINE_API_USER=your_api_user_here
SIGHTENGINE_API_SECRET=your_api_secret_here
